# Copy to .env on the LAN machine running go2rtc. Never commit .env.
# Preferred credential source: the local Home Assistant config directory.
# Leave blank and set QACCESS/QUUID below for a standalone relay.
HA_CONFIG_DIR=/path/to/home-assistant/config
# QACCESS=current-access-token
# QUUID=qubo-user-uuid
# QREFRESH=optional-refresh-token
# QSOURCE=optional-source-device-id
QDEVICE=doorbell-device-uuid
QUNIT=home-unit-uuid
QMOB=paired-phone-device-uuid
QADVERT=192.168.1.10
QPORT=49700
QQUALITY=high
QVIDEOFPS=10
QDUR=86400
QMEDIATIMEOUT=30
QSTALLTIMEOUT=120
# Camera microphone audio is enabled by default.
QAUDIO=true
QAUDIOWAIT=8
# The observed microphone track averages about -54 dB. This gain plus the
# built-in limiter makes it audible without clipping louder transients.
QAUDIOGAINDB=20
# Experimental browser microphone -> doorbell speaker path. Enable only after
# receive audio works and use headphones during the first test to prevent echo.
QTALK=false
# Raise outgoing speech while limiting peaks to prevent clipping. Reduce this
# if the doorbell speaker distorts; increase cautiously up to about 18 dB.
QTALKGAINDB=12
QFFMPEG=ffmpeg
